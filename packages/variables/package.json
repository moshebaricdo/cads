{
  "name": "@moshebaricdo/cads-variables",
  "version": "0.1.2",
  "description": "CADS design variables — color, typography, spacing/shape, effects, and generated MUI theme",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/moshebaricdo/cads.git",
    "directory": "packages/variables"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./variables.css": "./dist/variables.css",
    "./primitiveColors.css": "./dist/primitiveColors.css",
    "./colors.css": "./dist/colors.css",
    "./fontVariables.css": "./dist/fontVariables.css",
    "./typographyVariables.css": "./dist/typographyVariables.css",
    "./typography.module.scss": "./dist/typography.module.scss",
    "./shapeAndSpacingVariables.css": "./dist/shapeAndSpacingVariables.css",
    "./motionVariables.css": "./dist/motionVariables.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./data/color-system.json": "./src/data/codeAiColorSystem.json"
  },
  "files": [
    "dist",
    "src/data"
  ],
  "scripts": {
    "generate": "tsup && node src/scripts/generate-variables.mjs",
    "build": "pnpm run generate",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@mui/material": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mui/material": "^9.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
