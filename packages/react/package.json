{
  "name": "@codeai/cads-react",
  "version": "0.1.0",
  "description": "CADS React components (MUI-wrapped) and icons",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "./src/icons/fonts.css",
    "./dist/icons/fonts.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/cads.manifest.d.ts",
      "import": "./dist/manifest/cads.manifest.js"
    },
    "./icons/fonts.css": "./src/icons/fonts.css",
    "./icons/fonts-solid.css": "./src/icons/fonts-solid.css"
  },
  "files": [
    "dist",
    "src/icons/fonts",
    "src/icons/fonts.css",
    "src/icons/fonts-solid.css",
    "src/manifest"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-assets.mjs",
    "audit:specificity": "node scripts/audit-mui-specificity.mjs",
    "typecheck": "tsc --noEmit && pnpm run audit:specificity",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@codeai/cads-variables": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "motion": "^12.42.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "glob": "^13.0.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.102.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
