  "acceptedDifferences": [
    {
      "description": "Figma desktopTruncate is a discrete variant; code has no separate breakpoint value.",
      "reason": "Figma cannot express hug-until-truncate; code uses flex-shrink + min-width: 0 + ellipsis so truncation emerges from container width.",
      "owner": "user request (2026-09-03)",
      "affectedCases": [
        "progress-widget-desktop-truncate-light"
      ]
    },
    {
      "description": "Figma bubbleSlot paints a full 1px box; code uses left/right dividers only (dropdown | bubbles | action).",
      "reason": "The widget root already owns the outer stroke. Figma’s full slot border is a hug/fill workaround and doubled up in code. Explicit owner request.",
      "owner": "user request (2026-09-03)",
      "affectedCases": [
        "progress-widget-desktop-saved-light",
        "progress-widget-desktop-offline-light",
        "progress-widget-desktop-truncate-light"
      ]
    },
    {
      "description": "Cloud tooltip (Saved X minutes ago / Offline) is code-only.",
      "reason": "Requested behavior; Figma models no hover surface for the cloud icon.",
      "owner": "user request (2026-09-03)",
      "affectedCases": [
        "all"
      ]
    },
    {
      "description": "More menu contents are code-defined (levelLabel heading + moreMenuOptions); Figma only annotates 'Opens \"More\" menu.'",
      "reason": "No menu spec in Figma; GlobalHeader feeds Share/Remix below 576 per the header annotation.",
      "owner": "agent (2026-11-10) — confirm with design",
      "affectedCases": [
        "progress-widget-lt768-light"
      ]
    }
